# ==============================================================
# CRM & WHATSAPP CHATBOT - FACULTAD DE MEDICINA UDEA
# CONFIGURACIÓN DE ENTORNO Y SEGURIDAD
# ==============================================================

# Puerto de la aplicación
PORT=3000

# Clave de API de Google Gemini (Obtenla gratis en https://aistudio.google.com/)
# Si se deja vacía, el sistema usa el motor de conocimiento local inteligente.
GEMINI_API_KEY=

# Límite mensual de seguridad para WhatsApp Cloud API (Meta regala 1000)
# Se recomienda 950 para garantizar $0 costo (Buffer de seguridad del 5%)
MONTHLY_CONVERSATION_LIMIT=950

# Meta WhatsApp Cloud API (Opcional - solo cuando tengas tu cuenta de Meta Developers)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=udea_medicina_secure_token_2026
META_APP_SECRET=

# Notificaciones a Asesores (Correo SMTP Gmail opcional)
ADVISOR_NOTIFICATION_EMAIL=extensionmedicina@udea.edu.co
SMTP_USER=
SMTP_PASS=
